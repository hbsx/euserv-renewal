# EUserv account
EUSERV_USERNAME=
EUSERV_PASSWORD=
EUSERV_CONTRACT_NUMBER=
EUSERV_LOGIN_URL=https://support.euserv.de/

# Gmail verification PIN
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
GMAIL_FROM_HINT=euserv
GMAIL_SUBJECT_HINT=PIN for the Confirmation of a Security Check
CODE_REGEX=(?<!\d)(\d{6})(?!\d)
GMAIL_IMAP_HOST=imap.gmail.com
GMAIL_IMAP_TIMEOUT=20
GMAIL_CONFIRMATION_TIMEOUT=300

# Optional Gmail-only SOCKS5 proxy
GMAIL_SOCKS_HOST=
GMAIL_SOCKS_PORT=

# Browser
HEADLESS=true
TIMEOUT_SECONDS=40
CHROME_BINARY=/usr/bin/chromium
CHROME_PROFILE_DIR=/opt/euserv-renewal/browser-profile

# Optional Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional Telegram-only SOCKS5 proxy
TELEGRAM_SOCKS_HOST=
TELEGRAM_SOCKS_PORT=
