[Unit]
Description=EUserv monthly contract renewal
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/euserv-renewal
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /opt/euserv-renewal/euserv_renew.py --commit
TimeoutStartSec=30min
Restart=no
